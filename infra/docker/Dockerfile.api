FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/db-schema/package.json packages/db-schema/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/config/package.json packages/config/
COPY packages/queues/package.json packages/queues/
COPY packages/search/package.json packages/search/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @reachinbox/api... build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages/db-schema/node_modules ./packages/db-schema/node_modules
COPY --from=deps /repo/packages/shared-types/node_modules ./packages/shared-types/node_modules
COPY --from=deps /repo/packages/config/node_modules ./packages/config/node_modules
COPY --from=deps /repo/packages/queues/node_modules ./packages/queues/node_modules
COPY --from=deps /repo/packages/search/node_modules ./packages/search/node_modules
COPY --from=deps /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/packages/db-schema/dist ./packages/db-schema/dist
COPY --from=build /repo/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=build /repo/packages/config/dist ./packages/config/dist
COPY --from=build /repo/packages/queues/dist ./packages/queues/dist
COPY --from=build /repo/packages/search/dist ./packages/search/dist
COPY --from=build /repo/apps/api/dist ./apps/api/dist
COPY packages/db-schema/schema.sql packages/db-schema/schema.sql
WORKDIR /repo/apps/api
EXPOSE 3001
CMD ["node", "dist/server.js"]
