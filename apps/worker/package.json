{
  "name": "@reachinbox/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./workers": "./dist/workers.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test src/__tests__/*.test.ts 2>/dev/null || echo 'no tests'"
  },
  "dependencies": {
    "@reachinbox/config": "workspace:*",
    "@reachinbox/db-schema": "workspace:*",
    "@reachinbox/queues": "workspace:*",
    "@reachinbox/search": "workspace:*",
    "bullmq": "^5.34.5",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
