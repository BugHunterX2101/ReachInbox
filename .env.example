# --- Data stores ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Worker tuning (FR-16, FR-18, FR-19) ---
WORKER_CONCURRENCY=10
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR=500
MAX_EMAILS_PER_HOUR_PER_SENDER=100
QUEUE_PREFIX=reachinbox

# --- Retry / backoff ---
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAYS_MS=30000,60000,120000
RETRY_JITTER_PCT=0.2

# --- Reconciliation ---
RECONCILE_LEASE_TIMEOUT_MS=300000

# --- Reindex repeatable job (never cron) ---
REINDEX_INTERVAL_SECONDS=900
MAINTENANCE_INTERVAL_SECONDS=300

# --- Services ---
PORT=3001
WEB_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Google OAuth (real credentials required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Slack OAuth (real credentials required) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
